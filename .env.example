# URL do site em produção (usado no sitemap, OG, redirect Stripe). Use a URL canônica do domínio.
# Site acessado em phoenixglobal.com.br → use https://phoenixglobal.com.br ou https://www.phoenixglobal.com.br
NEXT_PUBLIC_SITE_URL=https://phoenixglobal.com.br

# Número do WhatsApp Business com DDI, sem + (usado em todos os links wa.me).
# Brasil: 55 + DDD + número. Ex.: (85) 99448-2323 = 5585994482323
NEXT_PUBLIC_WHATSAPP_NUMBER=5585994482323

# Stripe (gateway de pagamento) — ver docs/DADOS-STRIPE-E-VERCEL.md
# Chaves em https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Analytics (fase 3)
# Defina pelo menos um:
# - NEXT_PUBLIC_GTM_ID (ex.: GTM-XXXXXXX) para Google Tag Manager
# - NEXT_PUBLIC_GA_MEASUREMENT_ID (ex.: G-XXXXXXXXXX) para GA4 direto
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Atendente virtual (DeepSeek) — servidor apenas; obtenha em https://platform.deepseek.com
# Nunca use prefixo NEXT_PUBLIC (a chave não pode ir ao navegador).
DEEPSEEK_API_KEY=
# Opcional: deepseek-chat (padrão) ou deepseek-reasoner para raciocínio mais pesado
# DEEPSEEK_MODEL=deepseek-chat

# ─── Deploy Vercel (opcional; usado por npm run vercel:env e vercel:check) ───
# VERCEL_TOKEN=
# VERCEL_PROJECT=
# VERCEL_TEAM_ID=

# ─── PAIOS — sync catálogo interno (GET /api/internal/catalog) ───
# Token para PAIOS puxar estoque/preços do site. Pode ser igual a PAIOS_WEBHOOK_SECRET.
PAIOS_CATALOG_SYNC_SECRET=
# PAIOS_WEBHOOK_SECRET=  (alternativa aceita pelo endpoint se CATALOG_SYNC não definido)

# ─── PAIOS — webhooks site → Central de Operações Autônomas ───
# URL base da API PAIOS (sem trailing slash). Ex.: http://127.0.0.1:3050 ou https://meta.phoenixglobalholding.com
PAIOS_WEBHOOK_URL=
# Segredo compartilhado com PAIOS (header X-PAIOS-Webhook-Secret). Nunca use NEXT_PUBLIC_.
PAIOS_WEBHOOK_SECRET=
